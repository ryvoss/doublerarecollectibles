generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------
// ADMIN AUTHENTICATION
// ---------------------------------------------------------

// Admin credentials and web sessions are operational security records only.
// They are deliberately independent from all business/accounting models.
model AdminUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique @db.VarChar(100)
  passwordHash String    @db.Text
  role         AdminRole @default(ADMIN)
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

enum AdminRole {
  ADMIN
}

// connect-pg-simple owns the contents of this table. Declaring it in Prisma
// keeps the production schema and migration history explicit.
model AdminSession {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("admin_session")
}

// ---------------------------------------------------------
// PRODUCTS
// ---------------------------------------------------------

model Product {
  id                Int             @id @default(autoincrement())
  itemId            String          @unique
  name              String
  displayName       String?
  shortDescription  String?
  imageKey          String?
  type              ProductType
  unitType          ProductUnitType @default(BOX)
  parentProductId   Int?
  quantityPerParent Int?
  sellable          Boolean         @default(true)
  active            Boolean         @default(true)
  expectedSalePrice Decimal?        @db.Decimal(10, 2)
  publicVisible     Boolean         @default(false)
  publicPrice       Decimal?        @db.Decimal(10, 2)
  compareAtPrice    Decimal?        @db.Decimal(10, 2)
  priceUpdatedAt    DateTime?
  featured          Boolean         @default(false)
  packsPerBox       Int?
  packDisplayName   String?
  defaultPackPrice  Decimal?        @db.Decimal(10, 2)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  parentProduct Product?  @relation("ProductHierarchy", fields: [parentProductId], references: [id])
  childProducts Product[] @relation("ProductHierarchy")

  purchasedOrderLines OrderLine[] @relation("PurchasedProduct")
  sellableOrderLines  OrderLine[] @relation("SellableProduct")

  inventoryBatches InventoryBatch[]
  saleLines        SaleLine[]

  packPoolsAsSource PackPool[]         @relation("PackPoolSource")
  showPackSnapshots ShowPackSnapshot[] @relation("ShowPackSnapshotSource")

  @@index([publicVisible, active, sellable])
}

enum ProductType {
  SEALED
  SINGLE
}

enum ProductUnitType {
  CASE
  BOX
  ITEM
}

// ---------------------------------------------------------
// PUBLIC SITE CONTENT
// ---------------------------------------------------------

model SiteSettings {
  id                   Int      @id @default(1)
  businessName         String
  tagline              String
  heroTitle            String
  heroSubtitle         String
  primaryCtaLabel      String
  primaryCtaTarget     String   @default("INVENTORY")
  secondaryCtaEnabled  Boolean  @default(false)
  secondaryCtaLabel    String
  secondaryCtaTarget   String   @default("SHOWS")
  featuredSectionTitle String
  featuredMaxItems     Int      @default(4)
  featuredPrioritizeRecentDrops Boolean @default(true)
  featuredIncludeFeatured Boolean @default(true)
  featuredIncludeComingSoon Boolean @default(true)
  featuredFallback     String   @default("AVAILABLE")
  comingSoonSectionTitle String @default("Coming Soon")
  comingSoonMaxItems   Int      @default(4)
  nextShowSectionTitle String   @default("Next Show")
  buySellTradeTitle    String
  buySellTradeText     String
  buySellTradeCtaLabel String   @default("Learn how it works")
  inventoryPageTitle   String
  inventoryIntroText   String
  showsPageTitle       String
  showsIntroText       String
  contactPageTitle     String
  contactText          String
  instagramUrl         String
  contactEmail         String
  homepageSections     Json
  announcementEnabled Boolean  @default(false)
  announcementMessage String   @default("")
  announcementCtaLabel String  @default("")
  announcementCtaTarget String @default("INVENTORY")
  announcementStartsAt DateTime?
  announcementEndsAt   DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SiteAsset {
  id        Int           @id @default(autoincrement())
  type      SiteAssetType @unique
  imageKey  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum SiteAssetType {
  PRIMARY_LOGO
  FAVICON
  HERO_IMAGE
}

// ---------------------------------------------------------
// ORDERS
// ---------------------------------------------------------

model Order {
  id           Int         @id @default(autoincrement())
  orderNumber  String      @unique
  orderDate    DateTime
  shippingCost Decimal     @default(0) @db.Decimal(10, 2)
  tariffCost   Decimal     @default(0) @db.Decimal(10, 2)
  otherCost    Decimal     @default(0) @db.Decimal(10, 2)
  adjustment   Decimal     @default(0) @db.Decimal(10, 2)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  status       OrderStatus @default(DRAFT)
  finalizedAt  DateTime?
  inTransitAt  DateTime?

  lines OrderLine[]

  fundEntry FundEntry?
  corrections OrderCorrection[]
}

enum OrderStatus {
  DRAFT
  FINALIZED
}

model OrderLine {
  id                 Int      @id @default(autoincrement())
  orderId            Int
  purchasedProductId Int
  sellableProductId  Int
  quantityPurchased  Int
  productCost        Decimal  @db.Decimal(10, 2)
  sellableQuantity   Int
  landedCost         Decimal? @db.Decimal(10, 2)
  landedUnitCost     Decimal? @db.Decimal(14, 6)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  order            Order   @relation(fields: [orderId], references: [id])
  purchasedProduct Product @relation("PurchasedProduct", fields: [purchasedProductId], references: [id])
  sellableProduct  Product @relation("SellableProduct", fields: [sellableProductId], references: [id])

  inventoryBatches InventoryBatch[]
  correctionChanges OrderCorrectionChange[]
}

// Finalized orders remain locked. Each correction is an immutable record of
// an explicitly approved financial reconciliation applied to current values.
model OrderCorrection {
  id            Int      @id @default(autoincrement())
  orderId       Int
  reason        String   @db.VarChar(200)
  notes         String?  @db.VarChar(2000)
  oldOrderTotal Decimal  @db.Decimal(14, 2)
  newOrderTotal Decimal  @db.Decimal(14, 2)
  fundImpact    Decimal  @db.Decimal(14, 2)
  createdAt     DateTime @default(now())

  order     Order                   @relation(fields: [orderId], references: [id])
  changes   OrderCorrectionChange[]
  fundEntry FundEntry?

  @@index([orderId, createdAt])
}

model OrderCorrectionChange {
  id                Int      @id @default(autoincrement())
  orderCorrectionId Int
  orderLineId       Int?
  field             String   @db.VarChar(40)
  oldValue          Decimal  @db.Decimal(18, 6)
  newValue          Decimal  @db.Decimal(18, 6)

  orderCorrection OrderCorrection @relation(fields: [orderCorrectionId], references: [id])
  orderLine       OrderLine?      @relation(fields: [orderLineId], references: [id])

  @@index([orderCorrectionId])
  @@index([orderLineId])
}

// ---------------------------------------------------------
// INVENTORY BATCHES
// ---------------------------------------------------------

model InventoryBatch {
  id                Int      @id @default(autoincrement())
  orderLineId       Int      @unique
  sellableProductId Int
  quantityPurchased Int
  quantityReceived  Int      @default(0)
  landedCost        Decimal  @db.Decimal(10, 2)
  landedUnitCost    Decimal  @db.Decimal(14, 6)
  quantitySold      Int      @default(0)
  quantityConverted Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  orderLine       OrderLine @relation(fields: [orderLineId], references: [id])
  sellableProduct Product   @relation(fields: [sellableProductId], references: [id])

  saleAllocations     SaleAllocation[]
  packPoolAllocations PackPoolSourceAllocation[]
  receiptEvents       InventoryReceiptEvent[]
}

enum InventoryReceiptEventType {
  RECEIVED
  RECLASSIFIED_INBOUND
}

// Append-only physical receiving history. Financial ownership and landed cost
// remain on InventoryBatch; these events only explain availability changes.
model InventoryReceiptEvent {
  id               Int                       @id @default(autoincrement())
  inventoryBatchId Int
  type             InventoryReceiptEventType
  quantityDelta    Int
  occurredAt       DateTime                  @default(now())

  inventoryBatch InventoryBatch @relation(fields: [inventoryBatchId], references: [id])

  @@index([inventoryBatchId, occurredAt])
}

// ---------------------------------------------------------
// PACK INVENTORY
// ---------------------------------------------------------

model PackPool {
  id                 Int      @id @default(autoincrement())
  sourceBoxProductId Int
  packDisplayName    String
  showVisitId        Int?
  boxesConsumed      Int
  packsCreated       Int
  packsRemaining     Int
  totalCostBasis     Decimal  @db.Decimal(14, 2)
  remainingCostBasis Decimal  @db.Decimal(14, 2)
  costPerPack        Decimal  @db.Decimal(18, 6)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sourceBoxProduct  Product                    @relation("PackPoolSource", fields: [sourceBoxProductId], references: [id])
  showVisit         ShowVisit?                 @relation(fields: [showVisitId], references: [id])
  sourceAllocations PackPoolSourceAllocation[]
  showAllocations   ShowPackPoolAllocation[]

  @@index([sourceBoxProductId, createdAt])
  @@index([showVisitId])
}

model PackPoolSourceAllocation {
  id               Int      @id @default(autoincrement())
  packPoolId       Int
  inventoryBatchId Int
  quantityBoxes    Int
  unitCost         Decimal  @db.Decimal(14, 6)
  totalCost        Decimal  @db.Decimal(14, 2)
  createdAt        DateTime @default(now())

  packPool       PackPool       @relation(fields: [packPoolId], references: [id])
  inventoryBatch InventoryBatch @relation(fields: [inventoryBatchId], references: [id])

  @@unique([packPoolId, inventoryBatchId])
  @@index([inventoryBatchId])
}

model ShowPackSnapshot {
  id                   Int       @id @default(autoincrement())
  showVisitId          Int
  sourceBoxProductId   Int
  packDisplayName      String
  startingPacks        Int
  addedPacks           Int       @default(0)
  giveaways            Int       @default(0)
  damaged              Int       @default(0)
  endingPacks          Int?
  packsSold            Int?
  declaredValuePerPack Decimal   @db.Decimal(10, 2)
  startingCostBasis    Decimal   @db.Decimal(14, 2)
  startingCostPerPack  Decimal   @db.Decimal(18, 6)
  addedCostBasis       Decimal   @default(0) @db.Decimal(14, 2)
  declaredSalesValue   Decimal?  @db.Decimal(14, 2)
  estimatedCogs        Decimal?  @db.Decimal(14, 2)
  giveawayCostBasis    Decimal?  @db.Decimal(14, 2)
  damagedCostBasis     Decimal?  @db.Decimal(14, 2)
  actualRevenue        Decimal?  @db.Decimal(14, 2)
  actualCashRevenue    Decimal?  @db.Decimal(14, 2)
  actualDigitalRevenue Decimal?  @db.Decimal(14, 2)
  actualGrossProfit    Decimal?  @db.Decimal(14, 2)
  actualGrossMargin    Decimal?  @db.Decimal(12, 6)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  finalizedAt          DateTime?

  showVisit   ShowVisit                @relation(fields: [showVisitId], references: [id])
  sourceBoxProduct Product             @relation("ShowPackSnapshotSource", fields: [sourceBoxProductId], references: [id])
  allocations ShowPackPoolAllocation[]
  fundEntries FundEntry[]

  @@unique([showVisitId, sourceBoxProductId])
  @@index([sourceBoxProductId])
}

model ShowPackPoolAllocation {
  id                 Int                    @id @default(autoincrement())
  showPackSnapshotId Int
  packPoolId         Int
  type               ShowPackAllocationType
  quantityAllocated  Int
  costBasisAllocated Decimal                @db.Decimal(14, 2)
  quantityConsumed   Int                    @default(0)
  costBasisConsumed  Decimal                @default(0) @db.Decimal(14, 2)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  showPackSnapshot ShowPackSnapshot @relation(fields: [showPackSnapshotId], references: [id])
  packPool         PackPool         @relation(fields: [packPoolId], references: [id])

  @@index([showPackSnapshotId, createdAt])
  @@index([packPoolId])
}

enum ShowPackAllocationType {
  STARTING
  ADDED
}

// ---------------------------------------------------------
// SALES
// ---------------------------------------------------------

model Sale {
  id            Int           @id @default(autoincrement())
  saleNumber    String        @unique
  saleDate      DateTime
  paymentMethod PaymentMethod
  showVisitId   Int?
  notes         String?
  createdAt     DateTime      @default(now())
  finalizedAt   DateTime?

  showVisit ShowVisit? @relation(fields: [showVisitId], references: [id])

  lines SaleLine[]

  fundEntry FundEntry?
}

model SaleLine {
  id            Int      @id @default(autoincrement())
  saleId        Int
  productId     Int
  quantity      Int
  unitSalePrice Decimal  @db.Decimal(10, 2)
  revenue       Decimal  @db.Decimal(10, 2)
  cogs          Decimal  @db.Decimal(10, 2)
  grossProfit   Decimal  @db.Decimal(10, 2)
  grossMargin   Decimal  @db.Decimal(10, 6)
  createdAt     DateTime @default(now())

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  allocations SaleAllocation[]
}

model SaleAllocation {
  id               Int      @id @default(autoincrement())
  saleLineId       Int
  inventoryBatchId Int
  quantity         Int
  unitCost         Decimal  @db.Decimal(14, 6)
  totalCost        Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())

  saleLine       SaleLine       @relation(fields: [saleLineId], references: [id])
  inventoryBatch InventoryBatch @relation(fields: [inventoryBatchId], references: [id])
}

enum PaymentMethod {
  CASH
  DIGITAL
}

// ---------------------------------------------------------
// SHOWS
// ---------------------------------------------------------

model Show {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  active    Boolean  @default(true)
  notes     String?
  publicVisible Boolean @default(false)
  venue        String?
  location     String?
  boothInfo    String?
  publicNote   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits ShowVisit[]

  @@index([publicVisible])
}

model ShowVisit {
  id                   Int             @id @default(autoincrement())
  showId               Int
  visitDate            DateTime
  status               ShowVisitStatus @default(PLANNED)
  startedAt            DateTime?
  startingSinglesValue Decimal         @default(0) @db.Decimal(10, 2)
  endingSinglesValue   Decimal?        @db.Decimal(10, 2)
  startingCash         Decimal         @default(0) @db.Decimal(10, 2)
  endingCash           Decimal?        @db.Decimal(10, 2)
  startingDigital      Decimal         @default(0) @db.Decimal(10, 2)
  endingDigital        Decimal?        @db.Decimal(10, 2)
  notes                String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  finalizedAt          DateTime?

  show Show @relation(fields: [showId], references: [id])

  sales         Sale[]
  fundEntries   FundEntry[]
  packPools     PackPool[]
  packSnapshots ShowPackSnapshot[]

  @@unique([showId, visitDate])
  @@index([status])
}

enum ShowVisitStatus {
  PLANNED
  ACTIVE
  FINALIZED
}

// ---------------------------------------------------------
// FUNDS
// ---------------------------------------------------------

model FundEntry {
  id                 Int           @id @default(autoincrement())
  source             FundSource
  location           FundLocation?
  type               FundEntryType
  amount             Decimal       @db.Decimal(14, 2)
  transactionDate    DateTime
  saleId             Int?          @unique
  orderId            Int?          @unique
  orderCorrectionId  Int?          @unique
  showVisitId        Int?
  showPackSnapshotId Int?
  note               String?
  createdAt          DateTime      @default(now())

  sale             Sale?             @relation(fields: [saleId], references: [id])
  order            Order?            @relation(fields: [orderId], references: [id])
  orderCorrection  OrderCorrection?  @relation(fields: [orderCorrectionId], references: [id])
  showVisit        ShowVisit?        @relation(fields: [showVisitId], references: [id])
  showPackSnapshot ShowPackSnapshot? @relation(fields: [showPackSnapshotId], references: [id])

  @@index([source, transactionDate])
  @@index([source, location])
  @@index([showVisitId])
  @@index([showPackSnapshotId])
}

enum FundSource {
  SEALED
  SINGLES
}

enum FundLocation {
  CASH
  DIGITAL
}

enum FundEntryType {
  OPENING_BALANCE
  SEALED_SALE
  ORDER_PURCHASE
  ORDER_CORRECTION
  SINGLES_SHOW_GAIN
  PACK_SHOW_REVENUE
  PERSONAL_CONTRIBUTION
  MANUAL_ADJUSTMENT
}

// ---------------------------------------------------------
// WHAT-IF SCENARIOS
// ---------------------------------------------------------

// Analytical workspace data is deliberately isolated from transactional
// Sale, InventoryBatch, FundEntry, Order, and Show records.
model WhatIfScenario {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(100)
  baseSource   String   @default("CURRENT_INVENTORY") @db.VarChar(40)
  scenarioData Json     @default("{\"lines\":[]}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lines WhatIfScenarioLine[]
}

model WhatIfScenarioLine {
  id            Int      @id @default(autoincrement())
  scenarioId    Int
  productId     Int
  quantity      Int
  unitSalePrice Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  scenario WhatIfScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([scenarioId, productId])
  @@index([scenarioId])
}

// Read-only historical reporting records derived from authoritative business
// tables. One row is maintained per calendar day.
model BusinessPositionSnapshot {
  id                           Int      @id @default(autoincrement())
  snapshotDate                 DateTime @unique @db.Date
  snapshotAt                   DateTime @default(now())
  totalBusinessFunds           Decimal  @db.Decimal(14, 2)
  sealedFunds                  Decimal  @db.Decimal(14, 2)
  singlesFunds                 Decimal  @db.Decimal(14, 2)
  sealedInventoryCost          Decimal  @db.Decimal(14, 2)
  sealedInventoryOnHandCost    Decimal  @db.Decimal(14, 2)
  sealedInventoryInboundCost   Decimal  @db.Decimal(14, 2)
  singlesInventoryValue        Decimal? @db.Decimal(14, 2)
  totalBusinessValue           Decimal? @db.Decimal(14, 2)
  sealedExpectedRetail         Decimal  @db.Decimal(14, 2)
  expectedPricingComplete      Boolean?
  missingExpectedPriceProducts Int?
  missingExpectedPriceUnits    Int?

  @@index([snapshotDate])
}
