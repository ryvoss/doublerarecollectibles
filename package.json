{
  "name": "doublerarecollectibles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "dev:test": "vite --mode test",
    "server:test": "node --env-file=.env.test --import tsx src/server/server.ts",
    "test:setup": "node scripts/test-setup.mjs",
    "test:reset": "node --env-file=.env.test scripts/test-reset.mjs",
    "test:unit": "node --import tsx --test --test-isolation=none --test-concurrency=1 src/shared/*.test.ts src/server/reporting/*.test.ts src/server/services/*.test.ts",
    "test:auth": "node --import tsx --test --test-isolation=none --test-concurrency=1 src/server/auth/*.test.ts",
    "test": "npm run test:unit && npm run test:auth",
    "build": "prisma generate --config prisma7.config.ts && tsc -b && vite build && npm run build:server",
    "build:server": "esbuild src/server/server.ts scripts/bootstrap-admin.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outdir=dist-server --entry-names=[name]",
    "start": "node dist-server/server.js",
    "db:migrate:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "auth:bootstrap-admin": "node --import tsx scripts/bootstrap-admin.ts",
    "auth:bootstrap-admin:if-configured": "node dist-server/bootstrap-admin.js --if-configured",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^18.0.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^24.13.3",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "~0.28.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
