APP_ENV=REAL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/double_rare_collectibles"
# Optional when the provider supplies a separate direct connection for migrations.
# It must name the same database as DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/double_rare_collectibles"

# Railway supplies PORT automatically. This value is useful for local production smoke tests.
PORT=3002
NODE_ENV=production

# Required in production. Use the exact public origin, with no path or trailing slash.
APP_ORIGIN=https://your-app.example.com

# Required for admin login sessions. Generate a long random value and never
# expose it to Vite or commit the real value.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Public contact form delivery. Keep the API key server-side and use a From
# address on a sending domain that has been verified with Resend.
# RESEND_API_KEY=re_replace-me
# CONTACT_FORM_FROM_EMAIL=Double Rare Website <website@notify.example.com>
# CONTACT_FORM_TO_EMAIL=owner@example.com

# Local development implementation only; Railway application disk is not durable storage.
IMAGE_STORAGE_DRIVER=local
LOCAL_UPLOADS_DIR=uploads

# Production S3-compatible storage. Railway can inject the unprefixed aliases
# BUCKET, ENDPOINT, ACCESS_KEY_ID, SECRET_ACCESS_KEY, and REGION instead.
# IMAGE_STORAGE_DRIVER=s3
# S3_BUCKET_NAME=double-rare-images
# S3_ENDPOINT=https://example.storage.invalid
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# S3_REGION=auto
# S3_FORCE_PATH_STYLE=false
